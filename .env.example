# Compose reads these two secrets from .env. Generate each separately:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
SESSION_SECRET=

# For running Python directly against an existing PostgreSQL database.
DATABASE_URL=postgresql://gamedeals@localhost:5432/gamedeals
PUBLIC_BASE_URL=http://localhost:8000

# Google OAuth redirect URI is PUBLIC_BASE_URL/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, enables importing public Steam libraries.
STEAM_API_KEY=

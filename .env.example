# Compose reads these two secrets from .env. Generate each separately:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
SESSION_SECRET=

# For running Python directly against an existing PostgreSQL database.
DATABASE_URL=postgresql://gamedeals@localhost:5432/gamedeals
PUBLIC_BASE_URL=http://localhost:8000

# Google OAuth redirect URI is PUBLIC_BASE_URL/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional, enables importing public Steam libraries after OpenID verification.
STEAM_API_KEY=

# Optional OAuth2 credentials for direct gaming profile connections.
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
GOG_CLIENT_ID=
GOG_CLIENT_SECRET=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
